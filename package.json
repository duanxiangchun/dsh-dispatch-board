{
  "name": "dsh-taskboard",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件：派单模式 + 侧边栏任务看板。主 Agent 只拆解/派发/审核/汇报，子 Agent 干活，看板四列（待开始/进行中/已完成/已归档）可视化并由轮询自动派发。Dispatcher mode plus a sidebar task board for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./presets/*.patch.yml": "./presets/*.patch.yml"
  },
  "files": [
    "lib",
    "locale",
    "presets",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/taskboard.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "external": []
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "taskboard",
    "subagent",
    "dispatcher",
    "web-ui"
  ],
  "license": "MIT"
}

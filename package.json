{
  "name": "dsh-dispatch-board",
  "version": "0.3.9",
  "description": "DeepSeek Harness 插件：派单看板 + 工作区组长模式。组长派 worker 执行，看板四列跟踪进度与结论。A dispatch board and workspace-lead mode for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./presets/*.patch.yml": "./presets/*.patch.yml"
  },
  "files": [
    "lib",
    "locale",
    "presets",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/taskboard.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "external": []
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "taskboard",
    "subagent",
    "dispatcher",
    "web-ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duanxiangchun/dsh-dispatch-board.git"
  },
  "homepage": "https://github.com/duanxiangchun/dsh-dispatch-board#readme",
  "bugs": {
    "url": "https://github.com/duanxiangchun/dsh-dispatch-board/issues"
  },
  "author": "duanxiangchun"
}
